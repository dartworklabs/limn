# limn:generated — `limn start`/`limn add` render this file from the package template
# (limn/systemd/limn@.service). Do not edit it by hand: the next start/update overwrites it.
#
# One Limn instance per manuscript. The instance name (%i) is the paper's slug.
#
#   config   @LIMN_CONFIG_DIR@/%i.env
#   app      the installed limn package (uv tool). Upgrade/rollback: `limn update [--ref <tag>]`
#   state    STATE_DIR from the config — pins, builds and logs are per instance
#   manage   `limn add|start|stop|update|list|status|url|snippet|doc|remove`
#
# ExecStart goes through `limn run` instead of calling the server directly because some arguments
# are conditional (--git-pull only when GIT_PULL=1; LABEL, ACCENT, DOCS and the access keys AUTH,
# AGENT_LOOPBACK, BIND, … only when set), which systemd cannot express. `limn run` validates the
# config and then execs the server.
#
# The server binds 127.0.0.1 unless BIND says otherwise, and refuses a non-loopback BIND unless
# AUTH=trusted-proxy (an authenticating proxy in front). Tailnet exposure is done by `tailscale
# serve`, set up by `limn add|start` for the tailscale provider only. Agents authenticate with
# `limn token create %i`. Never use funnel — manuscripts are unpublished.
[Unit]
Description=Limn manuscript instance %i (PDF drag -> SyncTeX .tex line)
After=network-online.target
# Starting a name without a config stops here instead of looping through failures.
ConditionPathExists=@LIMN_CONFIG_DIR@/%i.env

[Service]
Type=simple
Environment=LIMN_CONFIG_DIR=@LIMN_CONFIG_DIR@
# Put the TeX used for rebuilds first on PATH. systemd units do not read shell rc files, so they do
# not inherit the interactive PATH; without this, rebuilds pick the distribution's pdflatex and fail
# to find journal classes (.cls). `limn` fills this with the directory of the pdflatex found in the
# shell that renders the unit (override with LIMN_UNIT_PATH).
Environment=PATH=@LIMN_PATH@
# With GIT_PULL=1 every rebuild fast-forwards the manuscript checkout to upstream (only when clean
# and fast-forwardable). There is no SSH agent or tty inside the unit, so fail fast instead of
# waiting on a prompt.
Environment=GIT_TERMINAL_PROMPT=0
Environment="GIT_SSH_COMMAND=ssh -o BatchMode=yes"
# Startup logs (manuscript, state, address) go straight to the journal. Per-instance logs live in
# `journalctl --user -u limn@%i` and STATE_DIR/build.log.
Environment=PYTHONUNBUFFERED=1
ExecStart=@LIMN_BIN@ run %i
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
