# 원고 핀 뷰어 — 논문 하나당 인스턴스 하나. 인스턴스 이름(%i)은 논문 슬러그다.
#
#   설정   ~/.config/pin-viewer/%i.env   (원본: machines/<id>/pin-viewer/%i.env)
#   앱     ~/.local/share/pin-viewer/app/pin_server.py + vendor/pdfjs/  (모든 인스턴스가 공유)
#   상태   설정의 STATE_DIR (기본 ~/.local/share/pin-viewer/%i) — 핀·빌드·로그가 인스턴스마다 따로
#   관리   `pin-viewer add|start|stop|update|list|status|url|snippet|remove` (bin/pin-viewer.sh)
#
# 앱을 플러그인 캐시에서 바로 돌리지 않는 이유: 캐시 경로에 버전 해시가 들어 있어
# 플러그인을 업데이트할 때마다 바뀐다. 유닛이 캐시를 가리키면 업데이트 한 번에 모든
# 뷰어가 죽는다. 고정 위치 사본을 두고 `pin-viewer update` 가 그것만 갈아 끼운다.
#
# ExecStart 가 python 을 직접 부르지 않고 `pin-viewer run` 을 거치는 이유: 인자 일부가
# 조건부다(GIT_PULL=1 일 때만 --git-pull, LABEL·ACCENT 는 설정에 있고 **앱 사본이 그
# 인자를 알 때만**). systemd 는 조건부 인자를 표현하지 못하고, 모르는 인자를 넘기면
# 서버가 argparse 오류로 죽어 Restart 루프만 돈다. 래퍼는 검사 뒤 python 으로 exec 한다.
#
# 바인딩은 127.0.0.1 뿐이다(서버에 박혀 있다). 테일넷 노출은 `tailscale serve` 가 맡고
# `pin-viewer add|start` 가 건다. funnel 은 쓰지 않는다 — 미공개 원고다.
[Unit]
Description=Manuscript pin viewer %i (PDF drag -> SyncTeX .tex line)
After=network-online.target
# 설정이 없는 이름으로 시작하면 조용히 실패 루프를 도는 대신 여기서 멈춘다.
ConditionPathExists=%h/.config/pin-viewer/%i.env

[Service]
Type=simple
EnvironmentFile=%h/.config/pin-viewer/%i.env
# TeX Live 2025 를 PATH 맨 앞에 둔다 --- 없으면 뷰어의 재빌드가 우분투 기본
# `/usr/bin/pdflatex` 를 잡아 `elsarticle.cls` 를 못 찾고 실패한다(실측,
# 2026-09-21). 대화형 셸은 `kpsewhich elsarticle.cls` 가
# `/usr/local/texlive/2025/texmf-dist/...` 를 돌려주지만, systemd 유닛은 셸 rc 를
# 거치지 않아 그 PATH 를 물려받지 못한다.
Environment=PATH=/usr/local/texlive/2025/bin/x86_64-linux:/usr/local/bin:/usr/bin:/bin
# GIT_PULL=1 이면 재빌드마다 원고 체크아웃을 업스트림으로 fast-forward 한다(깨끗하고 앞으로만 갈 때만).
# 공저자가 PR 을 머지해도 뷰어에 반영되지 않던 것을 막는다. 유닛 안에서는 SSH 에이전트도 tty 도
# 없으므로, 묻는 창이 뜨면 기다리지 말고 곧바로 실패하게 한다(실측 2026-09-22: 키로 fetch 성공).
Environment=GIT_TERMINAL_PROMPT=0
Environment="GIT_SSH_COMMAND=ssh -o BatchMode=yes"
# 기동 로그(원고·상태·주소)가 journal 에 바로 찍히게 한다 — 인스턴스별 로그는
# `journalctl --user -u pin-viewer@%i` 와 STATE_DIR/build.log 두 곳이다.
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/pin-viewer run %i
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
